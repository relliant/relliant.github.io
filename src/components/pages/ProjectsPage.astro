const t = copy[lang]
const backHref = isZh ? '/zh' : '/'
---

<Button title={t.back} href={backHref} variant='back' />
<main class='mt-6 lg:mt-10'>
  <div id='content-header' class='animate'>
    <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>{t.title}</h1>
  </div>

  <section
    aria-label={t.title}
    class='animate prose mt-8 max-w-none text-base md:min-w-[45ch]'
    id='content'
  >
    <p>{t.intro}</p>

    {
      t.projects.map((project) => (
        <>
          <h2 id={project.id}>{project.title}</h2>
          <Card subheading={project.date}>
            <ul class='ms-4 list-disc text-muted-foreground'>
              {project.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {'videos' in project && project.videos && (
              <div
                class:list={[
                  'not-prose mb-3 grid grid-cols-1 gap-3 sm:grid-cols-2',
                  project.columns === 'three' && 'lg:grid-cols-3'
                ]}
              >
                {project.videos.map((video) => (
                  <video
                    class='aspect-video w-full rounded-xl border object-cover'
                    controls
                    autoplay
                    muted
                    loop
                    playsinline
                    preload='metadata'
                    poster={video.poster}
                  >
                    <source src={video.src} type={video.type} />
                    Your browser does not support the video tag.
                  </video>
                ))}
              </div>
            )}
            {'href' in project && project.href && (
              <div class='not-prose mt-3'>
                <Button
                  title={t.projectAddress}
                  href={project.href}
                  target='_blank'
                  variant='ahead'
                />
              </div>
            )}
          </Card>
        </>
      ))
    }
  </section>
</main>
